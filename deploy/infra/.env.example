# Horizon infra stack config. Copy to `.env` and fill in. `.env` is gitignored — never commit it.

# Persistent data root on the host. Must exist.
HORIZON_DATA_ROOT=/volume1/docker/horizon

# --- TimescaleDB: primary application database ---
POSTGRES_USER=horizon_user
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=horizon_db

# --- MLflow backend: separate role + DB, auto-created on first DB init ---
MLFLOW_DB_USER=mlflow_user
MLFLOW_DB_PASSWORD=change_me_strong
MLFLOW_DB_NAME=mlflow_db

# --- Host port mappings (left side of host:container). Change only on collisions. ---
DB_PORT=5432
MLFLOW_PORT=5000
ADMINER_PORT=8080
