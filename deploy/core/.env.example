# Horizon core stack config. Copy to `.env` and fill in. `.env` is gitignored — never commit it.

# --- Infra host: replace `infra-host` with the hostname/IP running the infra stack,
#     and use the matching POSTGRES_* / port values from infra/.env. ---
DATABASE_URL=postgres://horizon:change_me_strong@infra-host:5432/horizon_db
MLFLOW_TRACKING_URI=http://infra-host:5000

# --- Alpaca (paper trading keys) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Cloudflare named-tunnel token ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- API CORS: comma-separated origins. Replaces the old hardcoded 192.168.1.99. ---
CORS_ORIGINS=http://localhost:5173

# --- Host port for the API (left side of host:container). ---
API_PORT=8080
