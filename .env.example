# Copy to .env and fill in real values. .env is gitignored — never commit it.
#   cp .env.example .env
# DATABASE_URL is one libpq string: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Passwords with @ : / # must be percent-encoded (@ -> %40, # -> %23).
# Add ?sslmode=disable to the end only if you hit a TLS error.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/horizon"

ALPACA_API_KEY=""
ALPACA_SECRET_KEY=""

MLFLOW_TRACKING_URI="http://HOST:5000"
